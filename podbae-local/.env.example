PORT=5000
SESSION_SECRET=dev-secret-change-me
WEB_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Auto "like back" for demo accounts so mutual matches are demoable
DEMO_AUTO_LIKE=true

# Optional: only change Hey Bae replies (mock reply is used when empty)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Layer 1: Podcast Intelligence (all optional; works with zero keys) ----
INTEL_DATABASE_URL=            # default: sqlite file ./data/intel.db (WAL + sqlite-vec). Postgres+pgvector: postgresql+psycopg://...
INTEL_VECTOR_BACKEND=sqlite-vec  # or pgvector
INTEL_EMBED_MODEL=intfloat/multilingual-e5-small   # or "hash" for a tiny offline fallback
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
TADDY_USER_ID=
TADDY_API_KEY=
INTEL_TADDY_ENABLED=false
INTEL_WHISPER_ENABLED=false
INTEL_BUDGET_GLOBAL_MONTHLY_USD=5
INTEL_BUDGET_PODCAST_MONTHLY_USD=0.10
