# PodBae local: copy to .env (npm run setup does not overwrite an existing .env).
# Every value here is safe for local development. Nothing requires an API key.

# ---------------------------------------------------------------------------
# Express API (apps/api) + web
# ---------------------------------------------------------------------------
# Express API port (the web dev server proxies /api to it)
PORT=5000
# cookie-session signing secret; change for anything non-local
SESSION_SECRET=dev-secret-change-me
# CORS origin of the web app
WEB_ORIGIN=http://localhost:5173
# where the Python AI service listens (bound to 127.0.0.1 only)
AI_SERVICE_URL=http://127.0.0.1:8000
# demo accounts "like back" automatically so mutual matches are demoable
DEMO_AUTO_LIKE=true

# ---------------------------------------------------------------------------
# Service-to-service auth (REQUIRED for the app to reach the AI service)
# Every AI-service route except /health and /v1/health requires the header X-Service-Token with this value.
# Express sends it automatically. If it is empty, the AI service rejects every call (fails closed).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
INTEL_SERVICE_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# LLM (Phase 4 refiners + card phrasing; Hey Bae stays on its mock unless openai/anthropic)
# The LLM is used ONLY where rules were weak (see PHASE4_REPORT.md). Only public podcast content is ever sent.
# KILL SWITCHES: LLM_PROVIDER=mock  or  INTEL_LLM_REFINE=false  -> exact Phase 3 behaviour (no calls, LLM values ignored).
# ---------------------------------------------------------------------------
# mock | ollama | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
INTEL_LLM_REFINE=false
# Ollama: local daemon. Cloud model needs `ollama signin` + credits; llama3.1:8b runs locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
LLM_RATE_PER_MIN=30          # client-side limiter (0 = off; use 0 for a local model)
LLM_THINK=low                # sent only to models that support thinking; thinking text is never stored
LLM_CONFIDENCE_CAP=0.6       # max confidence of any LLM-derived value
LLM_PHRASE_DAILY_CALLS=300   # card phrasing budget (calls/day)
LLM_ORGANIC_SAMPLE=1500      # organic_mention audit sample size
INTEL_LLM_PHRASING=true      # extra switch for AI-phrased card text only

# ---------------------------------------------------------------------------
# Intelligence store (services/ai)
# ---------------------------------------------------------------------------
# empty = sqlite file ./data/intel.db (WAL + sqlite-vec). Prod: postgresql+psycopg://user:pass@host/db (untested)
INTEL_DATABASE_URL=
# sqlite-vec | pgvector (pgvector path written but untested)
INTEL_VECTOR_BACKEND=sqlite-vec
# local GPU/CPU sentence-transformer; "hash" = tiny offline fallback (tests)
INTEL_EMBED_MODEL=intfloat/multilingual-e5-small
# run the in-process job worker inside the AI service
INTEL_WORKER=true
# salt for one-way hashes of feed owner e-mails (used only for dedupe; raw e-mails are never stored)
INTEL_HASH_SALT=podbae-intel-owner-v1

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# Apple iTunes Search API: no key. Used for discovery + seed. Rate-limited and cached.
# Apple asks for roughly 20 calls/min
INTEL_ITUNES_RATE_PER_MIN=20
# identical searches within this window are served from the local cache
INTEL_ITUNES_CACHE_HOURS=24
# storefront used for search
INTEL_ITUNES_COUNTRY=US
# Podcast Index (free key; implemented but NOT tested: no key here)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Taddy (implemented but NOT tested: no key here; also behind a flag)
TADDY_USER_ID=
TADDY_API_KEY=
INTEL_TADDY_ENABLED=false
# Whisper transcription (opt-in, owner-only, off by default; actual transcription is untested)
INTEL_WHISPER_ENABLED=false

# ---------------------------------------------------------------------------
# Feed fetching (politeness + safety). SSRF protection is always on; there is no switch for it here.
# ---------------------------------------------------------------------------
# seconds, read timeout per request
INTEL_HTTP_TIMEOUT=20
# seconds, connect timeout
INTEL_HTTP_CONNECT_TIMEOUT=10
# extra attempts on timeout / connection reset / 5xx (with backoff)
INTEL_FEED_RETRIES=1
# feeds larger than this are rejected (reason: too_large)
INTEL_MAX_FEED_BYTES=25000000
INTEL_MAX_TRANSCRIPT_BYTES=2000000
# INTEL_USER_AGENT=                        # override the default honest "PodBaeIntel" user agent

# ---------------------------------------------------------------------------
# Budgets (USD estimates; checked before every paid / GPU call; exceeding degrades gracefully)
# ---------------------------------------------------------------------------
INTEL_BUDGET_GLOBAL_MONTHLY_USD=5
INTEL_BUDGET_PODCAST_MONTHLY_USD=0.10
# price used to cost local embedding time
INTEL_COST_GPU_SECOND_USD=0.0003
INTEL_COST_TADDY_REQUEST_USD=0.002
INTEL_COST_WHISPER_MIN_USD=0.003
